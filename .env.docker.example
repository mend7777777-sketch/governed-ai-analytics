MYSQL_DATABASE=ai_analytics
MYSQL_USER=ai_analytics
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
MYSQL_PORT=3306

OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-provider.example/v1

JWT_SECRET=replace-with-a-long-random-secret

# Created only when the Docker MySQL volume is initialized for the first time.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
INITIAL_ADMIN_DISPLAY_NAME=平台管理员

# Optional demo data size.
MOCK_ORDERS=100000
MOCK_USERS=10000
MOCK_PRODUCTS=500
