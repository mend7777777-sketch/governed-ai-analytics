# MySQL connection. Do not commit a real .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_analytics
MYSQL_USER=ai_analytics
MYSQL_PASSWORD=replace-with-your-password
DB_POOL_SIZE=8
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10
MYSQL_CONNECT_TIMEOUT_SECONDS=10
MYSQL_READ_TIMEOUT_SECONDS=35
MYSQL_WRITE_TIMEOUT_SECONDS=35
MYSQL_QUERY_TIMEOUT_MS=30000
# Local MySQL often needs this enabled; set false when production TLS is configured.
MYSQL_SSL_DISABLED=true

# A model supported by your OpenAI-compatible API account.
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-4o-mini

# Optional for providers that support the standard OpenAI SDK environment variable.
# OPENAI_BASE_URL=https://your-provider.example/v1

# Optional: production deployments point this to a mounted persistent volume.
# CHROMA_PATH=storage/chroma_ai_analytics
JWT_SECRET=replace-with-a-long-random-secret
